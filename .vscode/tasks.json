{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MongoDB",
      "type": "process",
      "command": "podman-compose",
      "args": ["-f", "docker-compose.dev.yml", "up", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Stop MongoDB",
      "type": "process",
      "command": "podman-compose",
      "args": ["-f", "docker-compose.dev.yml", "stop", "mongodb"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build API",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "MediaSet.Api/MediaSet.Api.csproj"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "Prepare API",
      "dependsOrder": "sequence",
      "dependsOn": ["Start MongoDB", "Build API"],
      "problemMatcher": []
    },
    {
      "label": "Watch API",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "--project", "MediaSet.Api", "run"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Start MongoDB",
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Now listening on:"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Start UI",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/MediaSet.Remix" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^(never-match-this-vite-output):(.*)$", "file": 1, "message": 2 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:.*http"
        }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Start API + UI",
      "dependsOrder": "parallel",
      "dependsOn": ["Watch API", "Start UI"],
      "problemMatcher": []
    }
  ]
}
