{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Prepare API",
      "program": "${workspaceFolder}/MediaSet.Api/bin/Debug/net10.0/MediaSet.Api.dll",
      "cwd": "${workspaceFolder}/MediaSet.Api",
      "console": "integratedTerminal",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5000"
      }
    },
    {
      "name": "Launch UI",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/MediaSet.Remix",
      "serverReadyAction": {
        "pattern": "Local: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Launch UI — Mobile HTTPS",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:mobile",
      "cwd": "${workspaceFolder}/MediaSet.Remix",
      "serverReadyAction": {
        "pattern": "Local: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Launch API + UI",
      "configurations": ["Launch API", "Launch UI"],
      "stopAll": true
    },
    {
      "name": "Launch API + UI — Mobile HTTPS",
      "configurations": ["Launch API", "Launch UI — Mobile HTTPS"],
      "stopAll": true
    }
  ]
}
