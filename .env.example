# Copy to .env in the repository root. Compose reads this file for MongoDB only.
# Use distinct URL-safe passwords (for example: openssl rand -hex 24).
# Initialization applies only to an empty data/dev-mongodb directory.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

# Set the matching API connection string with .NET User Secrets; see
# Development/DEVELOPMENT.md. The API does not load this .env file.
# Frontend overrides belong in MediaSet.Remix/.env.local.
