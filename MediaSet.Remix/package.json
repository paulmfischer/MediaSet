{
  "name": "mediaset-remix",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "npm run css",
    "css": "tailwindcss -c tailwind.config.ts -i app/tailwind.css -o public/app.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.ts -i app/tailwind.css -o public/app.css --watch",
    "dev": "node --env-file-if-exists=.env.local dev.ts",
    "dev:mobile": "node --env-file-if-exists=.env.local dev.ts --mobile",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "eslint --cache --cache-location ./node_modules/.cache/eslint . --fix",
    "lint:format": "prettier --check \"*.ts\" \"app/**/*.{ts,tsx,json}\"",
    "lint:format:fix": "prettier --write \"*.ts\" \"app/**/*.{ts,tsx,json}\"",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "test": "npm run test:unit && npm run test:server",
    "test:unit": "vitest run",
    "test:server": "NODE_ENV=test remix test --type server",
    "test:e2e": "npm run css && NODE_ENV=test remix test --type browser --type e2e",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@zxing/library": "^0.18.6",
    "lucide": "^1.63.0",
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "playwright": "^1.64.1",
    "postcss": "^8.4.38",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "license": "Apache-2.0"
}
