# Optional overrides. Copy to .env.local only if you need them.
# Native development uses these defaults without an environment file:
# apiUrl=http://127.0.0.1:5000
# clientApiUrl=/dev-api
# VITE_API_URL=/dev-api
# VITE_APP_VERSION=0.0.0-dev

# Optional mobile HTTPS mode: npm run dev:mobile
# Paths are relative to MediaSet.Remix, or absolute.
# DEV_HTTPS_CERT=../data/certs/dev.pem
# DEV_HTTPS_KEY=../data/certs/dev-key.pem

# Optional frontend Seq logging (the API uses .NET User Secrets).
# ExternalLogging__Enabled=true
# ExternalLogging__SeqUrl=http://your-seq-host:5341
