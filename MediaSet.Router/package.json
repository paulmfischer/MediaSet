{
  "name": "mediaset-router",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:mobile": "react-router dev --mode mobile",
    "start": "node ./start.mjs",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:format": "prettier --check \"app/**/*.{ts,tsx,json}\" \"*.{ts,js,mjs,json}\"",
    "lint:format:fix": "prettier --write \"app/**/*.{ts,tsx,json}\" \"*.{ts,js,mjs,json}\"",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "isbot": "5.1.33",
    "lucide-react": "0.474.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@react-router/dev": "7.18.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "@vitest/coverage-v8": "4.0.17",
    "autoprefixer": "10.4.23",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "happy-dom": "21.0.4",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vite-tsconfig-paths": "6.0.4",
    "vitest": "4.0.17",
    "vitest-dom": "0.1.1"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "license": "Apache-2.0"
}
