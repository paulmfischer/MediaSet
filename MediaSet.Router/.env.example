# Server-only .NET API address; no VITE_ prefix.
API_URL=http://127.0.0.1:5100
# Browser/image URL, intentionally safe to serialize. Dev proxy shares HTTPS origin.
PUBLIC_API_URL=/dev-api
# Optional: npm run dev:mobile; select your intended LAN interface explicitly.
# DEV_HOST=192.168.50.100
# DEV_HTTPS_CERT=../data/certs/dev.pem
# DEV_HTTPS_KEY=../data/certs/dev-key.pem
